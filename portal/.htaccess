# Prevent directory listing
Options -Indexes

# Nothing in config/ or lib/ is ever opened directly; those files are only included by other scripts
RedirectMatch 403 ^/portal/config/
RedirectMatch 403 ^/portal/lib/

# Belt and braces for the config files themselves, wherever they sit
<FilesMatch "^(db|setup|mail)\.php(\.example)?$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
