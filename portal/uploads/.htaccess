# Uploaded documents are never served directly. download.php checks who is signed in first.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

# And nothing in this folder ever runs as a script, whatever its extension
RemoveHandler .php .phtml .php5 .php7 .php8 .phar .pl .py .cgi
